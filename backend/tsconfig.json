{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/importer/importar-base.js"
  ]
}
